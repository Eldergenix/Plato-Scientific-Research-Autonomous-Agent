{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Edge for the Plato autonomous scientist at https://jarvisos.xyz
  //   Worker      : accounts, static UI, read API (via Hyperdrive), cron resume
  //   Container   : Python LangGraph swarm + sandboxed experiments, one instance per campaign
  //   ProjectAgent: Durable Object per project running the orchestrator agent's turns
  //   Hyperdrive  : pooled connection from the Worker to Supabase Postgres
  "name": "plato-scientist",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "jarvisos.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replaced by scripts/deploy.sh with the id of the `plato-supabase` Hyperdrive config.
      "id": "7bdfd8b8daa54814acd0390ccf1dffd9",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PLATO_SCIENTIST", "class_name": "ScientistContainer" },
      { "name": "PROJECT_AGENT", "class_name": "ProjectAgent" }
    ]
  },
  "containers": [
    {
      "class_name": "ScientistContainer",
      "image": "../../docker/Dockerfile.scientist",
      "image_build_context": "../..",
      // 2 vCPU / 8 GiB / 16 GB disk: room for 3 concurrent sandboxed experiments.
      "instance_type": "standard-3",
      "max_instances": 10,
      "rollout_active_grace_period": 600
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScientistContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["ProjectAgent"] }
  ],
  // Every 5 minutes: wake the container of any unfinished campaign so crashed or evicted
  // runs resume from Postgres.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // The project agent (orchestrator) and the research threads' sub-agents. Optional
    // PLATO_ROLE_MODELS (a string holding a JSON object) overrides single sub-agent roles, e.g.
    // {"skeptic": "claude-sonnet-5-5"}; roles are listed in src/models.json. Usage counts
    // against budgets and the allowance at each model's price relative to Haiku 5.5.
    "PLATO_ORCHESTRATOR_MODEL": "claude-opus-5-5",
    "PLATO_SCIENTIST_MODEL": "claude-haiku-5-5",
    // Tokens each account may spend per calendar month on the default Anthropic key
    // (admins and accounts with their own key are not capped; admins can set per-account caps).
    "PLATO_DEFAULT_MONTHLY_TOKENS": "5000000",
    // E2B template the agents' sandboxes start from (scripts/e2b_lab_template.py builds it) and
    // the executor used when E2B_API_KEY is set (without the key, experiments run in the container).
    "PLATO_E2B_TEMPLATE": "plato-lab",
    "PLATO_DEFAULT_EXECUTOR": "e2b"
  },
  // Secrets (wrangler secret put): PLATO_API_TOKEN, PLATO_INTERNAL_TOKEN, PLATO_SECRETS_KEY
  // (32 random bytes, base64: password pepper and API-key encryption; never rotate it casually),
  // ANTHROPIC_API_KEY, PLATO_DATABASE_URL
  // Optional secrets: E2B_API_KEY (E2B experiment sandboxes), ADS_API_KEY (NASA ADS search), NCBI_API_KEY and SEMANTIC_SCHOLAR_KEY
  // (higher rate limits), MODAL_TOKEN_ID + MODAL_TOKEN_SECRET (Modal and GPU experiment runs)
  "observability": { "enabled": true }
}
